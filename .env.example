# Copy to .env for local development. In Cloud Run these come from env vars /
# Secret Manager (never commit real secrets).

# Public base URL of this server (no trailing slash). Used for OAuth metadata
# and the IdP redirect URI.
#   Local: http://localhost:8080
#   Prod:  https://SERVICE-PROJECTNUMBER.REGION.run.app
PUBLIC_BASE_URL=http://localhost:8080

PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# --- Identity provider OAuth client (Web application) ---
# Default skeleton uses Google. Create an OAuth "Web application" client and set
# the authorized redirect URI to  <PUBLIC_BASE_URL>/oauth/idp/callback
OIDC_CLIENT_ID=
# In prod this is injected from Secret Manager, NOT set here.
OIDC_CLIENT_SECRET=

# Only allow logins from this email domain (your org).
ALLOWED_DOMAIN=example.org

# --- Storage ---
GCP_PROJECT_ID=example-mcp-connector
FIRESTORE_DATABASE_ID=(default)
# Prefix for this connector's Firestore collections. Set a UNIQUE value per
# connector (e.g. drive_, coda_) so multiple connectors can share one project
# without colliding. Leave empty for a single-connector project.
FIRESTORE_COLLECTION_PREFIX=

# Secret used to sign OUR OWN MCP access/refresh JWTs (loaded from Secret
# Manager in prod). Generate with:  openssl rand -base64 48
JWT_SIGNING_SECRET=
