# Copy to .env for local development. In Cloud Run these come from env vars /
# Secret Manager (never commit real secrets).

# Public base URL of this server (no trailing slash). Used for OAuth metadata
# and the IdP redirect URI.
#   Local: http://localhost:8080
#   Prod:  https://SERVICE-PROJECTNUMBER.REGION.run.app
PUBLIC_BASE_URL=http://localhost:8080

PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# --- Identity provider OAuth client (Web application) ---
# Default skeleton uses Google. Create an OAuth "Web application" client and set
# the authorized redirect URI to  <PUBLIC_BASE_URL>/oauth/idp/callback
OIDC_CLIENT_ID=
# In prod this is injected from Secret Manager, NOT set here.
OIDC_CLIENT_SECRET=

# Only allow logins from this email domain (your org).
ALLOWED_DOMAIN=example.org

# --- Storage ---
GCP_PROJECT_ID=example-mcp-connector
FIRESTORE_DATABASE_ID=(default)
# Prefix for this connector's Firestore collections. Set a UNIQUE value per
# connector (e.g. drive_, coda_) so multiple connectors can share one project
# without colliding. Leave empty for a single-connector project.
FIRESTORE_COLLECTION_PREFIX=

# Secret used to sign OUR OWN MCP access/refresh JWTs (loaded from Secret
# Manager in prod). Generate with:  openssl rand -base64 48
JWT_SIGNING_SECRET=

# --- Cloud KMS (encrypts the Epic refresh token at rest) ---
# projects/P/locations/L/keyRings/R/cryptoKeys/K
KMS_KEY_NAME=

# --- Epic / MyChart ---
# Which Epic instance this deployment talks to. "sandbox" is Epic's shared
# synthetic-data environment; anything else is a real organization.
EPIC_ENVIRONMENT=sandbox
# FHIR R4 base URL.
#   sandbox:  https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4/
#   St. Jude: https://rp.stjude.org/oauth2-prd/api/FHIR/R4/
EPIC_FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4/
# Use the NON-PRODUCTION client id against the sandbox, the production id
# against a real organization.
EPIC_CLIENT_ID=
# Confidential client. In prod this comes from Secret Manager, never here.
# Epic only grants refresh tokens to confidential clients, which is what makes
# unattended sync possible at all.
EPIC_CLIENT_SECRET=
# Space-delimited SMART v1 scopes. offline_access is what yields a refresh token.
EPIC_SCOPES=openid fhirUser offline_access patient/*.read
